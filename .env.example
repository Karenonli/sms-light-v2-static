# === SMS Light — переменные окружения ===
#
# Скопируйте этот файл в .env и заполните значения.
# На Vercel эти переменные задаются в Dashboard → Project Settings → Environment Variables.

# === PostgreSQL (Neon) ===
# Создайте БД в Neon: https://neon.tech → New Project
# Или через Vercel: Storage → Connect Database → Neon
DATABASE_URL=postgres://user:pass@ep-example.aws.neon.tech/neondb?sslmode=require

# === SMTP (Mail.ru / inbox.ru) ===
# ВАЖНО: Mail.ru требует пароль приложения (app password) для SMTP!
# Создайте его: Mail.ru → Настройки → Безопасность → Пароли для внешних приложений
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@inbox.ru
SMTP_PASS=your-app-password
SMTP_FROM="SMS Light" <your-email@inbox.ru>

# === Секрет сессии ===
SESSION_SECRET=random-string-here
